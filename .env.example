# AgriMate Full-Stack Environment Variables (for Vercel & Local Deployment)

# Server Configuration (Optional on Vercel serverless)
PORT=5000
NODE_ENV=production
CLIENT_URL=

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/agrimate?retryWrites=true&w=majority
MONGODB_URI=

# External AI Assistant Integration (Optional - robust agronomic expert system fallback included)
# AI Provider: 'gemini' (default) or 'openai'
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest

# Weather Provider (Optional - Open-Meteo free high-precision agro-weather used automatically without key)
# For OpenWeatherMap (32-character hex key):
WEATHER_API_KEY=

# Mandi Market Data Provider (Optional)
MARKET_API_KEY=
